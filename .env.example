# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# DATABASE
DATABASE_URL=

# AUTH
BETTER_AUTH_URL= #Base URL of your app
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_WEBHOOK_VERIFY_TOKEN=any_random_string

# FITATU (unofficial API sync)
FITATU_USERNAME= # Fitatu account email
FITATU_PASSWORD=
FITATU_API_SECRET= # optional override; grab from DevTools "api-secret" header if the built-in default stops working
FITATU_SYNC_SECRET= # any random string; protects /api/fitatu/sync
FITATU_SYNC_USER_EMAIL= # app user whose daily_log receives the data