# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# DATABASE
DATABASE_URL=

# AUTH
BETTER_AUTH_URL= #Base URL of your app
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_WEBHOOK_VERIFY_TOKEN=any_random_string

# FITATU (unofficial API sync)
# FITATU_USERNAME is the Fitatu account email, FITATU_SYNC_USER_EMAIL the app
# user whose daily_log receives the data. FITATU_SYNC_SECRET is any random
# string protecting /api/fitatu/sync. FITATU_API_SECRET is optional — set it
# only if the built-in default stops working (grab the current "api-secret"
# request header from DevTools on fitatu.com).
FITATU_USERNAME=
FITATU_PASSWORD=
FITATU_API_SECRET=
FITATU_SYNC_SECRET=
FITATU_SYNC_USER_EMAIL=

# AI (weekly nutrition analysis)
OPENAI_API_KEY=